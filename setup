#!/usr/bin/env bash
# Plain Bash setup. Make provides the public interface; install orchestrates explicit stages.
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/scripts/lib.sh"

ACTION=${1:-plan}
[[ $# -le 1 ]] || { die 'Usage: ./setup ACTION (configure via HOST/DEV/EXTRA/PACKAGE)'; exit 1; }
if [[ -n ${ARCH_SETUP_USER_HOME:-} && $ACTION != _system && $ACTION != _services ]]; then
  die 'ARCH_SETUP_USER_HOME is reserved for the sudo helper'; exit 1
fi
load_settings
build_package_lists
service_names

case "$ACTION" in
  plan)
    printf '%s | filesystem=%s | encryption=no\n' "$HOST_NAME" "$FILESYSTEM"
    printf '\nOfficial packages:\n'; printf '  %s\n' "${OFFICIAL[@]}"
    printf '\nAUR packages via Paru (make aur):\n'; printf '  %s\n' "${AUR[@]}"
    printf '\nExternal checkouts:\n'
    while IFS=$'\t' read -r name url target; do
      [[ -n $name && $name != \#* ]] || continue
      printf '  %s -> ~/%s\n' "$name" "$target"
    done < "$ROOT/sources.tsv"
    printf '\nInstaller layers: Paru, pi, Herdr, Herdr plugin, Doom core\n'
    printf 'make install runs packages, configs, apps, service enablement and checks in order.\n'
    printf 'Enable-only services:\n'; printf '  %s\n' "${SERVICES[@]}" "${AUR_SERVICES[@]}"
    printf 'Ly will mask getty@%s; other consoles stay available.\n' "$LY_TTY"
    printf 'Boot setup is a separate pre-reboot checkpoint. No snapshots configured.\n'
    if [[ $AUDITED != 1 ]]; then printf 'WARNING: hardware audit pending; mutating targets refuse this host.\n'; fi
    ;;
  diff)
    load_files user "$HOME_DIR"; preview_files 1
    load_files system /; preview_files 1
    ;;
  aur-plan)
    select_aur_packages
    printf '%s\n' "${SELECTED_AUR[@]}"
    printf 'Command:'; printf ' %q' paru -S --needed --review --aur -- "${SELECTED_AUR[@]}"; printf '\n'
    ;;
  check)
    failed=0
    printf 'Host: %s\n' "$HOST_NAME"
    if command -v omarchy >/dev/null 2>&1 || [[ -d $HOME_DIR/.local/share/omarchy ]]; then
      printf 'INFO: Omarchy detected. Inspection allowed; applying this repo is blocked.\n'
    fi
    for package in "${OFFICIAL[@]}" "${AUR[@]}"; do
      if ! pacman -Q "$package" >/dev/null 2>&1; then printf 'MISSING package: %s\n' "$package"; failed=1; fi
    done
    for cmd in pi herdr brave 1password sioyek uv clang typst; do
      if command -v "$cmd" >/dev/null 2>&1; then printf 'OK executable: %s\n' "$cmd";
      else printf 'WARN missing executable: %s\n' "$cmd"; failed=1; fi
    done
    for unit in "${SERVICES[@]}" "${AUR_SERVICES[@]}"; do
      state=$(systemctl is-enabled "$unit" 2>/dev/null || true)
      printf 'SERVICE %s: %s\n' "$unit" "${state:-unavailable}"
      [[ $state == enabled || $state == enabled-runtime ]] || failed=1
    done
    load_files user "$HOME_DIR"; preview_files
    for row in "${FILE_ROWS[@]}"; do
      IFS=$'\t' read -r source target mode <<< "$row"
      file_same "$source" "$target" "$mode" || failed=1
    done
    load_files system /; preview_files
    for row in "${FILE_ROWS[@]}"; do
      IFS=$'\t' read -r source target mode <<< "$row"
      file_same "$source" "$target" "$mode" || failed=1
    done
    printf 'Config drift is listed above; physical hardware checks remain manual.\n'
    if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
      errors=$(hyprctl configerrors) || failed=1
      if [[ -n $errors ]]; then printf 'WARN: current Hyprland has configuration errors.\n'; failed=1;
      else printf 'Current Hyprland has no errors; this does NOT validate the unapplied repo config.\n'; fi
    fi
    exit "$failed"
    ;;
  boot-check)
    failed=0
    if [[ ! -r /boot/limine.conf ]]; then die 'Cannot read /boot/limine.conf; inspect the actual ESP configuration'; exit 1; fi
    if [[ -n $LIMINE_ROTATION ]]; then
      if grep -Eq "^[[:space:]]*interface_rotation:[[:space:]]*${LIMINE_ROTATION}[[:space:]]*$" /boot/limine.conf; then
        printf 'OK Limine menu rotation: %s\n' "$LIMINE_ROTATION"
      else printf 'WARN missing Limine rotation: %s\n' "$LIMINE_ROTATION"; failed=1; fi
    fi
    IFS= read -r cmdline < /proc/cmdline
    for arg in "${KERNEL_ARGUMENTS[@]}"; do
      if [[ " $cmdline " == *" $arg "* ]]; then printf 'OK running kernel argument: %s\n' "$arg";
      else printf 'WARN missing running kernel argument: %s\n' "$arg"; failed=1; fi
    done
    printf 'Read-only. Verify new kernel/UKI updates, console/Ly rotation, and recovery boot manually.\n'
    exit "$failed"
    ;;
  install)
    require_fresh_arch
    require_user
    export PATH="$HOME_DIR/.local/bin:$PATH"
    source "$ROOT/scripts/install.sh"
    install_run
    ;;
  boot-rotation|boot-rebuild)
    require_fresh_arch
    require_user
    [[ $HOST == minibook ]] || { die 'Boot rotation is only implemented for MiniBook'; exit 1; }
    if [[ $ACTION == boot-rebuild ]]; then
      grep -Eq '^default_uki="/boot/EFI/Linux/arch-linux.efi"$' /etc/mkinitcpio.d/linux.preset || {
        die 'Unexpected UKI preset; inspect the boot layout first'; exit 1;
      }
      sudo mkinitcpio -p linux
    else
      sudo bash "$ROOT/scripts/boot-rotation.sh"
    fi
    ;;
  packages|sources|apply-user|apply-system|services|paru|aur|pi|herdr|herdr-fetch|herdr-install|herdr-plugins|doom|shell|_system|_services)
    require_fresh_arch
    if [[ $ACTION == _system || $ACTION == _services ]]; then
      if ! { (( EUID == 0 )) && [[ -n ${SUDO_USER:-} && -n ${ARCH_SETUP_USER_HOME:-} ]]; }; then
        die 'Internal stage requires the sudo helper'; exit 1;
      fi
      account_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
      [[ $(realpath -- "$account_home") == "$HOME_DIR" ]] || { die 'Helper home does not match invoking user'; exit 1; }
    else
      require_user
      export PATH="$HOME_DIR/.local/bin:$PATH"
    fi

    case "$ACTION" in
      packages)
        printf 'Command:'; printf ' %q' sudo pacman -Syu --needed "${OFFICIAL[@]}"; printf '\n'
        printf '%s\n' 'Full system upgrade + official packages.'
        sudo pacman -Syu --needed "${OFFICIAL[@]}"
        ;;
      apply-user)
        load_files user "$HOME_DIR"; preview_files 1
        [[ -f $HOME_DIR/.oh-my-zsh/oh-my-zsh.sh ]] || { die 'Run make sources before applying the shell config'; exit 1; }
        [[ ${XDG_CONFIG_HOME:-$HOME_DIR/.config} == "$HOME_DIR/.config" ]] || {
          die 'Initial profile targets ~/.config; review custom XDG paths first'; exit 1;
        }
        printf '%s\n' 'Copying displayed user files after private backups.'
        copy_files "$HOME_DIR" "$HOME_DIR/.local/state/arch-setup/backups"
        if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
          hyprctl reload
          errors=$(hyprctl configerrors)
          [[ -z $errors ]] || { die 'Hyprland errors after apply: inspect locally and use the recorded backups'; exit 1; }
        else printf 'No GUI session. Launch Hyprland and run make check to validate.\n'; fi
        ;;
      apply-system)
        load_files system /; preview_files 1
        require_no_conflicts
        printf '%s\n' 'Applying displayed system files after backups.'
        sudo env HOST="$HOST" ARCH_SETUP_USER_HOME="$HOME_DIR" "$ROOT/setup" _system
        ;;
      services)
        printf 'Enable for next boot:\n'; printf '  %s\n' "${SERVICES[@]}" "${AUR_SERVICES[@]}"
        printf 'Mask getty@%s.service; do not start Ly now.\n' "$LY_TTY"
        require_no_conflicts
        printf '%s\n' 'Enabling services for the next boot.'
        sudo env HOST="$HOST" ARCH_SETUP_USER_HOME="$HOME_DIR" "$ROOT/setup" _services
        ;;
      _system)
        require_no_conflicts
        load_files system /; copy_files / /var/backups/arch-setup
        ;;
      _services)
        require_no_conflicts
        load_files system /
        for row in "${FILE_ROWS[@]}"; do
          IFS=$'\t' read -r source target mode <<< "$row"
          file_same "$source" "$target" "$mode" || { die "Apply system config first: $target"; exit 1; }
        done
        SERVICES+=("${AUR_SERVICES[@]}")
        for unit in "${SERVICES[@]}"; do
          systemctl cat "$unit" >/dev/null || { die "Missing service $unit: install reviewed packages first"; exit 1; }
        done
        systemctl daemon-reload
        systemctl mask "getty@$LY_TTY.service"
        systemctl enable "${SERVICES[@]}"
        printf 'Enabled for next boot. No services started/restarted. Reboot manually when ready.\n'
        ;;
      sources)
        # Validate all existing paths before cloning any missing checkout.
        validate_source_checkouts
        printf '%s\n' 'Cloning missing declared checkouts.'
        for row in "${CHECKOUT_PENDING[@]}"; do
          IFS=$'\t' read -r url path <<< "$row"
          mkdir -p -- "${path%/*}"
          git clone --depth 1 -- "$url" "$path"
        done
        ;;
      paru)
        if command -v paru >/dev/null 2>&1; then
          printf 'Existing Paru preserved; upgrades are separate.\n'
        else
          if ! command -v git >/dev/null 2>&1 || ! command -v makepkg >/dev/null 2>&1; then
            die 'Run make packages first to install Git and base-devel'; exit 1;
          fi
          path="$HOME_DIR/.cache/arch-setup/paru"
          no_symlink_parents "$path" "$HOME_DIR"
          status=0; checkout_valid "$path" https://aur.archlinux.org/paru.git || status=$?
          case $status in
            0) printf 'Existing Paru checkout kept without pulling/resetting.\n' ;;
            2)
              printf '%s\n' 'Fetching Paru build scripts from AUR.'
              mkdir -p -- "${path%/*}"
              git clone -- https://aur.archlinux.org/paru.git "$path"
              ;;
            *) exit "$status" ;;
          esac
          [[ -z $(git -C "$path" status --porcelain --untracked-files=no) ]] || {
            die 'Tracked Paru build files are modified; inspect separately'; exit 1;
          }
          [[ -f $path/PKGBUILD && ! -L $path/PKGBUILD ]] || { die 'Missing/unsafe Paru PKGBUILD'; exit 1; }
          printf 'Paru AUR revision: '; git -C "$path" rev-parse HEAD
          for script in "$path/PKGBUILD" "$path"/*.install; do
            [[ -e $script || -L $script ]] || continue
            [[ -f $script && ! -L $script ]] || { die 'Unsafe Paru install script'; exit 1; }
            printf '\n%s\n' "${script##*/}"
            while IFS= read -r line || [[ -n $line ]]; do printf '%s\n' "$line"; done < "$script"
          done
          printf '\nInspect other build files in %s before continuing.\n' "$path"
          printf '%s\n' 'Building/installing Paru as your user; makepkg may request sudo and install Rust build dependencies.'
          (cd -- "$path" && makepkg --syncdeps --install)
        fi
        ;;
      aur)
        select_aur_packages
        command -v paru >/dev/null 2>&1 || { die 'Paru is required: run make paru, then rerun make aur'; exit 1; }
        printf 'Command:'; printf ' %q' paru -S --needed --review --aur -- "${SELECTED_AUR[@]}"; printf '\n'
        if [[ " ${SELECTED_AUR[*]} " == *' limine-mkinitcpio-hook '* ]]; then
          printf 'Boot hook selected: review its configuration first; installation may regenerate boot files immediately.\n'
        fi
        printf '%s\n' 'Installing selected AUR packages through Paru. Review PKGBUILD/install scripts in Paru before accepting builds.'
        paru -S --needed --review --aur -- "${SELECTED_AUR[@]}"
        ;;
      pi)
        if command -v pi >/dev/null 2>&1; then printf 'Existing pi preserved; upgrades are separate.\n';
        else
          printf '%s\n' 'Installing current npm pi release into ~/.local.'
          npm install --global --prefix "$HOME_DIR/.local" @earendil-works/pi-coding-agent
        fi
        ;;
      herdr)
        if command -v herdr >/dev/null 2>&1; then
          printf 'Existing Herdr preserved; upgrades are separate.\n'
        else
          HOST="$HOST" "$ROOT/setup" herdr-fetch
          HOST="$HOST" "$ROOT/setup" herdr-install
          command -v herdr >/dev/null 2>&1 || { die 'Herdr installer finished but herdr is not on PATH; inspect before retrying'; exit 1; }
        fi
        ;;
      herdr-fetch)
        path="$HOME_DIR/.cache/arch-setup/herdr-install.sh"
        no_symlink_parents "$path" "$HOME_DIR"
        if [[ -e $path || -L $path ]]; then
          [[ -f $path && ! -L $path ]] || { die 'Unsafe/conflicting cached Herdr installer'; exit 1; }
          printf 'Keeping cached Herdr installer for review; no redownload.\n'
        else
          printf '%s\n' 'Downloading official Herdr installer for review.'
          mkdir -p -- "${path%/*}"
          # Only publish a complete download; failed fetches cannot become runnable cache entries.
          temp=$(mktemp "${path%/*}/.herdr-install-XXXXXX")
          if curl --fail --location --proto '=https' --output "$temp" https://herdr.dev/install.sh; then
            mv -T -- "$temp" "$path"
          else
            status=$?; rm -f -- "$temp"; exit "$status"
          fi
        fi
        sha256sum -- "$path"
        ;;
      herdr-install)
        path="$HOME_DIR/.cache/arch-setup/herdr-install.sh"
        no_symlink_parents "$path" "$HOME_DIR"
        [[ -f $path && ! -L $path ]] || { die 'Fetch installer first'; exit 1; }
        while IFS= read -r line || [[ -n $line ]]; do printf '%s\n' "$line"; done < "$path"
        sha256sum -- "$path"
        printf '%s\n' 'Executing the downloaded Herdr installer.'
        sh "$path"
        ;;
      herdr-plugins)
        plugins=$(herdr plugin list --json)
        jq -e '.result.plugins | type == "array"' <<< "$plugins" >/dev/null || {
          die 'Unexpected Herdr plugin list; inspect manually before installing'; exit 1;
        }
        if jq -e '.result.plugins[] | select(.plugin_id == "vim-herdr-navigation")' <<< "$plugins" >/dev/null; then
          jq -e '.result.plugins[] | select(.plugin_id == "vim-herdr-navigation" and .source.kind == "github" and .source.owner == "paulbkim-dev" and .source.repo == "vim-herdr-navigation")' <<< "$plugins" >/dev/null || {
            die 'Conflicting Vim-navigation plugin source; inspect manually'; exit 1;
          }
          printf 'Existing Herdr Vim-navigation plugin preserved (including its enabled/disabled preference).\n'
        else
          printf '%s\n' 'Installing the Herdr Vim-navigation plugin declared by your config.'
          herdr plugin install paulbkim-dev/vim-herdr-navigation
        fi
        ;;
      doom)
        core="$HOME_DIR/.config/emacs"
        validate_doom_core
        [[ -f $HOME_DIR/.config/doom/init.el ]] || { die 'Clone Doom config with make sources first'; exit 1; }
        if [[ -d $core ]]; then
          printf '%s\n' 'Matching Doom core preserved; no pull/reset. Rerunning its native installer to finish/check setup.'
        else
          printf '%s\n' 'Cloning Doom core and running its interactive installer.'
          git clone --depth 1 -- https://github.com/doomemacs/core "$core"
          validate_doom_core
        fi
        "$core/bin/doom" install
        ;;
      shell)
        printf '%s\n' 'Changing login shell to /usr/bin/zsh.'
        chsh -s /usr/bin/zsh
        ;;
    esac
    ;;
  *) die "Unknown action: $ACTION"; exit 1 ;;
esac
